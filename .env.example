# Environment Variables Template
# Copy these into your Vercel Dashboard (Settings > Environment Variables)

# ─── Database ───────────────────────────────────────────────
# Get these from Aiven.io or TiDB Cloud
DB_HOST=your-database-host.com
DB_USER=avnadmin
DB_PASSWORD=your-secure-password
DB_NAME=defaultdb
DB_PORT=25060

# ─── Security ────────────────────────────────────────────────
# Any long random string
JWT_SECRET=your_super_secret_jwt_key_123

# ─── Node ───────────────────────────────────────────────────
NODE_ENV=production
